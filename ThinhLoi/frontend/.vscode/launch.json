{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PackFlow Web (local env, port 3000)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/lib/main.dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--web-port=3000",
        "--dart-define-from-file=${workspaceFolder}/.env.local"
      ]
    }
  ]
}
